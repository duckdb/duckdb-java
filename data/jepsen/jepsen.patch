+(def ready-timeout
+  "How long, in milliseconds, we wait for a local node to start listening on
+  its port."
+  60000)
+
+(defn port-open?
+  "Returns true if we can open a TCP connection to the given local port."
+  [port]
+  (try (with-open [s (Socket.)]
+         (.connect s (InetSocketAddress. "127.0.0.1" (int port)) 1000)
+         true)
+       (catch IOException _
+         false)))
+
+(defn await-ready!
+  "Blocks until a freshly started local node is listening on its port. Throws
+  if the process exits first, or if it doesn't become ready within
+  `ready-timeout` ms."
+  [test {:keys [node, ^Process process]}]
+  (let [port     (port test node)
+        deadline (+ (System/currentTimeMillis) ready-timeout)]
+    (loop []
+      (cond (port-open? port)
+            (info "Local node" node "is listening on port" port)
+
+            (not (.isAlive process))
+            (throw+ {:type ::crashed-on-start
+                     :node node
+                     :port port
+                     :exit (.exitValue process)})
+
+            (< deadline (System/currentTimeMillis))
+            (throw+ {:type    ::start-timeout
+                     :node    node
+                     :port    port
+                     :timeout ready-timeout})
+
+            true
+            (do (Thread/sleep 100)
+                (recur))))))
+
